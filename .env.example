# GEMINI_API_KEY: Optional if server-side Gemini AI features are invoked.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION
# Local fallback: sqlite:///./fraud_database.db
# Docker compose: postgresql://fraudguard_user:fraudguard_secure_password@postgres:5432/fraudguard_db
DATABASE_URL="postgresql://fraudguard_user:fraudguard_secure_password@localhost:5432/fraudguard_db"

# STREAMING & KAFKA CONFIGURATION
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_TOPIC="payment-transactions"
KAFKA_DLQ_TOPIC="payment-transactions-dlq"

# SECURITY & AUTHENTICATION
JWT_SECRET="fraudguard_jwt_secret_placeholder_change_in_production"
JWT_ALGORITHM="HS256"

# DISPATCH NOTIFICATION CHANNELS (OPTIONAL)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="YOUR_SMTP_API_KEY"
SMTP_FROM_EMAIL="fraud-alerts@company.internal"
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_DEFAULT_CHAT_ID="@fraudguard_alerts_channel"
TWILIO_ACCOUNT_SID="YOUR_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="YOUR_TWILIO_AUTH_TOKEN"
TWILIO_PHONE_NUMBER="+15550192834"
